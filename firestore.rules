rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /menu/{id}     { allow read: if true; allow write: if false; }
    match /settings/{id} { allow read: if true; allow write: if false; }
    match /slots/{id}    { allow read: if true; allow write: if false; }
    match /orders/{id} {
      allow get:  if true;   // ids are unguessable 21-char nanoids
      allow list: if request.auth != null && request.auth.token.staff == true;
      allow write: if false;
    }
    match /counters/{id} { allow read, write: if false; }
  }
}
